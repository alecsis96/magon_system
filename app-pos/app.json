{
  "expo": {
    "name": "Magon POS",
    "slug": "magon-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "magonpos",
    "userInterfaceStyle": "light",
